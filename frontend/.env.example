# Copia este fichero como .env.local y rellena tus valores (.env.local NUNCA se sube a Git).
# Supabase: Project Settings → API. Usa SOLO la clave publicable (sb_publishable_…), nunca la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_...
# Cloudflare Turnstile (CAPTCHA): clave del sitio (pública). Vacía = sin CAPTCHA.
# Para probar en local sin cuenta: 1x00000000000000000000AA (clave de prueba de Cloudflare, siempre pasa).
VITE_TURNSTILE_SITE_KEY=
